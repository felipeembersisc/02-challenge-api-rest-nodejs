{
  "info": {
    "name": "Daily Diet API",
    "description": "Collection para a API REST de controle de refeições (Daily Diet).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "mealId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('userId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Felipe Embersisc\",\n  \"document\": \"12345678901\",\n  \"email\": \"felipe@example.com\",\n  \"phone\": \"11999999999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Cria um novo usuário. A resposta define automaticamente o cookie `sessionId` e salva o `userId` na variável da collection."
          },
          "response": []
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            },
            "description": "Busca um usuário pelo ID. Substitua `{{userId}}` pelo UUID do usuário."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Meals",
      "item": [
        {
          "name": "Create Meal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('mealId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"name\": \"Almoço saudável\",\n  \"description\": \"Frango grelhado com salada\",\n  \"inDiet\": true,\n  \"mealDate\": \"2026-06-25\",\n  \"mealTime\": \"12:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meals",
              "host": ["{{baseUrl}}"],
              "path": ["meals"]
            },
            "description": "Cria uma nova refeição. Requer o cookie `sessionId` (definido ao criar o usuário). Salva o `mealId` na variável da collection."
          },
          "response": []
        },
        {
          "name": "Get All Meals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meals?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meals"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            },
            "description": "Lista todas as refeições de um usuário. Requer o cookie `sessionId`."
          },
          "response": []
        },
        {
          "name": "Get Meal by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meals/{{mealId}}?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meals", "{{mealId}}"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            },
            "description": "Busca uma refeição pelo ID. Requer o cookie `sessionId`."
          },
          "response": []
        },
        {
          "name": "Update Meal",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"name\": \"Jantar leve\",\n  \"description\": \"Sopa de legumes\",\n  \"inDiet\": true,\n  \"mealDate\": \"2026-06-25\",\n  \"mealTime\": \"19:30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meals/{{mealId}}?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meals", "{{mealId}}"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            },
            "description": "Atualiza uma refeição pelo ID. Requer o cookie `sessionId`."
          },
          "response": []
        },
        {
          "name": "Delete Meal",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meals/{{mealId}}?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meals", "{{mealId}}"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            },
            "description": "Remove uma refeição pelo ID. Retorna 204 No Content. Requer o cookie `sessionId`."
          },
          "response": []
        },
        {
          "name": "Get Meal Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meals/metrics?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meals", "metrics"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            },
            "description": "Retorna as métricas de refeições do usuário (total, dentro/fora da dieta, melhor sequência etc). Requer o cookie `sessionId`."
          },
          "response": []
        }
      ]
    }
  ]
}
